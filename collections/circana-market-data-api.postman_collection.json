          "name": "Circana Get Point of Sale Data",
          "request": {
            "name": "Circana Get Point of Sale Data",
            "description": {
              "content": "Retrieve point-of-sale data with filters for time period, geography, category, and retailer. Returns sales volume, revenue, and unit data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "market-data",
                "pos"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "category_id",
                  "value": "<string>",
                  "description": "(Required) Product category identifier"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Start date for the data range in ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) End date for the data range in ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "geography",
